# -----------------------------------------------------------------------------
# Python / Virtual Environment & Cache
# -----------------------------------------------------------------------------
venv/
venv*/
.venv*/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/

# -----------------------------------------------------------------------------
# Environment & Secrets Configuration
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example

# -----------------------------------------------------------------------------
# Local Databases & Storage
# -----------------------------------------------------------------------------
*.db
*.sqlite*
*.sqlite3*

# -----------------------------------------------------------------------------
# Raw Telegram Chat Exports & Intermediate Dumps
# -----------------------------------------------------------------------------
# Raw exports are LOCAL-ONLY source files: they contain third-party channel messages and must
# never be committed. They live in data/raw/telegram/ (see services/raw_sources.py).
data/raw/
data/raw_exports/
# Same files if they are ever placed in the project root again:
/[0-9].json
/[0-9][0-9].json
/result.json
/result_*.json
# Extractor debug dumps (contain raw message blocks):
/debug_*.json
# Large intermediate extractor outputs (re-creatable from the raw exports):
data/*_extracted/

# -----------------------------------------------------------------------------
# Quality Reports & Temporary Files
# -----------------------------------------------------------------------------
quality_report.json
*_report.json
scratch/
*.log
*.pdf
.agents/
.DS_Store
Thumbs.db
