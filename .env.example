# ZakoWhat Environment Configuration
# Copy this file to .env and configure appropriate values for your environment.

# -----------------------------------------------------------------------------
# Runtime Environment & Database Safety
# -----------------------------------------------------------------------------
# ENVIRONMENT must be explicitly set: 'development', 'test', 'staging', or 'production'.
# If unset or empty, security-sensitive subsystems (database.py, api/auth.py) fail closed
# with a RuntimeError rather than assuming development.
ENVIRONMENT=development

# DB_TARGET declares the target database tier and MUST match ENVIRONMENT:
#   development -> points to local or dev database (e.g. Neon DEV branch)
#   test        -> points to isolated test database
#   staging     -> points to staging database
#   production  -> points to production database
# If unset or empty, database.py fails closed with a RuntimeError.
DB_TARGET=development

# Database connection URL (PostgreSQL)
# e.g., postgresql://user:password@ep-damp-frog-...aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/zakowhat_dev

# Optional explicit host verification guards (used by database environment safety validator):
# PROD_DATABASE_HOST=ep-prod-...aws.neon.tech
# DEV_DATABASE_HOST=ep-damp-frog-...aws.neon.tech

# -----------------------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------------------
# SECRET_KEY is mandatory in production. In development, a fallback is provided.
SECRET_KEY=change-this-in-production-to-a-secure-random-string-at-least-32-chars

# Mandatory for Owner administrative and editorial portal access (/owner, /api/owner):
# Supports singular OWNER_EMAIL or comma-separated OWNER_EMAILS.
# Fails closed (403 Forbidden) if unset.
OWNER_EMAIL=owner@zakowhat.uz
# OWNER_EMAILS=owner@zakowhat.uz,lead@zakowhat.uz

# Comma-separated list of admin/editor emails authorized to access private staging gameplay:
# Fails closed in production if unset.
ADMIN_EMAILS=owner@zakowhat.uz,editor@zakowhat.uz

# -----------------------------------------------------------------------------
# Google OAuth (Optional for local testing, required for Google sign-in)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
